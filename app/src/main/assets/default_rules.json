{
  "version": 1,
  "updatedAt": "2026-11-08T00:00:00Z",
  "rules": [
    {
      "pattern": "^(\\+?1?(800|888|877|866|855|844|833)\\d{7})$",
      "type": "CALL_REGEX",
      "action": "BLOCK",
      "description": "Toll-Free Telemarketing automated robocalls",
      "enabled": true
    },
    {
      "pattern": "^(\\+?91)?140\\d{7,8}$",
      "type": "CALL_REGEX",
      "action": "BLOCK",
      "description": "Indian Telecom Commercial Telemarketer Series (140)",
      "enabled": true
    },
    {
      "pattern": "(?i)\\b(pre-approved loan|lottery winner|crypto bonus|claim prize|credit card limit increase|casino bonus|work from home earn \\$)\\b",
      "type": "SMS_KEYWORD",
      "action": "BLOCK",
      "description": "Promotional financial & scam keywords",
      "enabled": true
    },
    {
      "pattern": "(?i)\\b(exclusive offer|flat 50% off|limited time discount|use coupon code|flash sale)\\b",
      "type": "NOTIFICATION_KEYWORD",
      "action": "BLOCK",
      "description": "Promotional & advertisement notifications",
      "enabled": true
    },
    {
      "pattern": "(?i)\\b(otp|verification code|one time password|secret code|do not share|valid for \\d+ mins?)\\b",
      "type": "WHITELIST_REGEX",
      "action": "ALLOW",
      "description": "Universal 2FA & Bank OTP Protection (High Priority)",
      "enabled": true
    }
  ]
}
