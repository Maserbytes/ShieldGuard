<?xml version="1.0" encoding="utf-8"?>
<!--
  ShieldGuard stores blocked message snippets and sender identifiers in a local database.
  That is sensitive communication metadata, so it must never be copied into a Google cloud
  backup or to a new device automatically. Backups are disabled entirely in the manifest;
  this file makes the intent explicit and survives future manifest edits.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
